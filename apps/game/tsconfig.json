{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["jest"]
  },
  "include": ["src", "test", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
